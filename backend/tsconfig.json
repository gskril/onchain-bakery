{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Run directly with Node's built-in type stripping, so there is no build step
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src"]
}
