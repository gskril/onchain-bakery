{
  "name": "onchain-bakery",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "backend:start": "pnpm --filter backend start",
    "backend:build": "pnpm --filter backend typecheck",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "catalog:"
  }
}
